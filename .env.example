# LiveKit Cloud → Settings → API keys (also used for Gemini via LiveKit Inference)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LLM_MODEL=google/gemini-3-flash-preview

# https://console.soniox.com (needed while STT/TTS_PROVIDER in agent.py is "soniox")
SONIOX_API_KEY=
# SONIOX_TTS_VOICE=Emma

# Docker only: set to 1 to bake the local STT/TTS models (~1 GB) into the image
LOCAL_MODELS=0

# Orders go to this Google Sheet (the ID in its URL); empty = save to orders.jsonl instead.
# Share the sheet with the service account's email as Editor. See README.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
